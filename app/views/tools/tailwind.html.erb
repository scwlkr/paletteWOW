<% content_for :title, "Tailwind colors · paletteWOW" %>

<article class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8" data-controller="swatch-copy">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl sm:text-4xl font-black tracking-tight">Tailwind colors</h1>
    <%= link_to "Generator", root_path, class: "text-sm font-medium underline underline-offset-4 rounded focus-visible:outline-2 focus-visible:outline-offset-4" %>
  </header>

  <p role="status" aria-live="polite" aria-atomic="true" data-swatch-copy-target="status" class="fixed bottom-4 left-4 right-4 z-50 mx-auto w-fit max-w-full rounded-xl bg-black text-white text-sm shadow-lg empty:hidden p-3 pointer-events-none"></p>

  <% @scales.each do |name, shades| %>
    <section aria-labelledby="<%= name %>-title">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h2 id="<%= name %>-title" class="text-xl font-bold"><%= name.to_s.capitalize %></h2>
        <%# A scale has 11 shades; shared palettes support at most 10. Open 100–950. %>
        <%= link_to "Open in generator", shared_palette_path(colors: shades.values.drop(1).map { |hex| hex.delete_prefix("#") }.join("-")), aria: { label: "Open #{name} 100–950 in generator" }, class: "text-sm font-medium underline underline-offset-4 rounded focus-visible:outline-2 focus-visible:outline-offset-4" %>
      </div>
      <ul class="grid grid-cols-3 sm:grid-cols-6 xl:grid-cols-11 gap-3">
        <% shades.each do |shade, hex| %>
          <%= render "tailwind_swatch", name: "#{name}-#{shade}", label: shade, hex: hex %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section aria-labelledby="base-colors-title">
    <h2 id="base-colors-title" class="text-xl font-bold mb-4">Black &amp; white</h2>
    <ul class="grid grid-cols-3 sm:grid-cols-6 xl:grid-cols-11 gap-3">
      <% { "Black" => "#000000", "White" => "#ffffff" }.each do |name, hex| %>
        <%= render "tailwind_swatch", name: name, label: name, hex: hex %>
      <% end %>
    </ul>
  </section>
</article>
