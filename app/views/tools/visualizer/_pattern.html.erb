<rect width="600" height="420" fill="var(--c1)" />
<% 4.times do |row| %>
  <% 6.times do |column| %>
    <g transform="translate(<%= column * 100 %> <%= row * 105 %>)">
      <path d="M0 0h100v105H0Z" fill="var(--c<%= (row + column) % 5 + 1 %>)" />
      <path d="M0 0a100 105 0 00100 105V0Z" fill="var(--c<%= (row + column + 1) % 5 + 1 %>)" />
      <circle cx="50" cy="52.5" r="18" fill="var(--c<%= (row + column + 3) % 5 + 1 %>)" />
    </g>
  <% end %>
<% end %>
