<% content_for :title, "Contrast checker | paletteWOW" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-6" data-controller="contrast" data-action="popstate@window->contrast#loadFromUrl">
  <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-8">Contrast checker</h1>

  <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] gap-4 items-end mb-8">
    <% [ [ "text", "Text colour", "#000000" ], [ "bg", "Background colour", "#ffffff" ] ].each_with_index do |(role, label, color), index| %>
      <% if index == 1 %>
        <button type="button" data-action="contrast#swap" class="justify-self-center border border-neutral-300 rounded-full px-5 py-3 text-sm font-bold hover:bg-neutral-50 transition-colors focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2">Swap</button>
      <% end %>
      <div>
        <label for="contrast-<%= role %>" class="block text-sm font-medium mb-2"><%= label %></label>
        <div class="flex gap-3 items-center border border-neutral-300 rounded-xl p-3 focus-within:ring-2 focus-within:ring-black">
          <input type="color" value="<%= color %>" aria-label="Pick <%= label.downcase %>" data-color="<%= role %>" data-contrast-target="<%= role %>Picker" data-action="input->contrast#pick" class="w-12 h-10 shrink-0 cursor-pointer bg-transparent rounded">
          <input id="contrast-<%= role %>" type="text" value="<%= color %>" aria-invalid="false" spellcheck="false" autocomplete="off" autocapitalize="off" data-color="<%= role %>" data-contrast-target="<%= role %>Hex" data-action="input->contrast#hexInput change->contrast#hexChange" class="w-full min-w-0 font-mono text-lg bg-transparent focus:outline-none">
        </div>
      </div>
    <% end %>
  </div>

  <section aria-label="Text preview" data-contrast-target="preview" class="rounded-2xl border border-neutral-200 px-6 py-12 sm:p-12 mb-8" style="color: #000000; background-color: #ffffff;">
    <p class="text-3xl sm:text-5xl font-bold mb-6">Colour makes a difference.</p>
    <p class="text-base leading-relaxed">The quick brown fox jumps over the lazy dog.</p>
  </section>

  <section aria-label="WCAG contrast results" aria-live="polite" aria-atomic="true" class="border border-neutral-200 rounded-2xl p-6 sm:p-8">
    <h2 class="text-sm font-medium mb-2">Contrast ratio</h2>
    <p data-contrast-target="ratio" class="text-5xl font-bold tracking-tight mb-8">—</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <% [ [ "Normal text", [ [ "aa", "AA" ], [ "aaa", "AAA" ] ] ], [ "Large text", [ [ "aaLarge", "AA" ], [ "aaaLarge", "AAA" ] ] ] ].each do |heading, levels| %>
        <div>
          <h3 class="font-medium mb-3"><%= heading %></h3>
          <div class="flex flex-wrap gap-2">
            <% levels.each do |level, label| %>
              <span data-contrast-target="badge" data-level="<%= level %>" data-label="<%= label %>" class="rounded-full px-4 py-2 text-sm font-bold bg-neutral-100 text-neutral-600"><%= label %> —</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>
