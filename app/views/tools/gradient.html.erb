<% content_for :title, "Gradient maker · paletteWOW" %>

<section class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8" data-controller="gradient">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <h1 class="text-3xl sm:text-4xl font-black tracking-tight">Gradient maker</h1>
    <%= link_to "Generator", root_path, class: "text-sm font-medium underline underline-offset-4 rounded focus-visible:outline-2 focus-visible:outline-offset-4" %>
  </div>

  <div role="img" aria-label="Gradient preview" data-gradient-target="preview" class="w-full aspect-[8/5] rounded-2xl border border-neutral-200 dark:border-neutral-700 mb-6"></div>

  <div class="flex flex-wrap items-end gap-4 mb-6">
    <div>
      <label for="gradient-type" class="block text-sm font-bold mb-2">Type</label>
      <select id="gradient-type" data-gradient-target="type" data-action="change->gradient#settings" class="bg-white dark:bg-neutral-800 rounded-lg border border-neutral-300 dark:border-neutral-700 px-4 py-3 focus-visible:outline-2 focus-visible:outline-offset-4">
        <option value="linear">Linear</option>
        <option value="radial">Radial</option>
      </select>
    </div>
    <div data-gradient-target="angleGroup">
      <label for="gradient-angle" class="block text-sm font-bold mb-2">Angle (°)</label>
      <input id="gradient-angle" type="number" min="0" max="360" step="0.01" value="90" data-gradient-target="angle" data-action="input->gradient#settings" class="bg-white dark:bg-neutral-800 w-28 rounded-lg border border-neutral-300 dark:border-neutral-700 px-4 py-3 focus-visible:outline-2 focus-visible:outline-offset-4">
    </div>
  </div>

  <div data-gradient-target="stops" data-action="input->gradient#edit click->gradient#remove" class="grid sm:grid-cols-2 gap-4 mb-4"></div>
  <button type="button" data-gradient-target="add" data-action="gradient#add" class="rounded-full border border-neutral-300 dark:border-neutral-700 font-bold px-5 py-3 cursor-pointer disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-4">Add stop</button>

  <div class="flex flex-wrap gap-3 mt-8 mb-4">
    <button type="button" data-action="gradient#copy" class="rounded-full bg-black dark:bg-white text-white dark:text-neutral-900 font-bold px-6 py-3 cursor-pointer hover:bg-neutral-800 dark:hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-4">Copy CSS</button>
    <button type="button" data-action="gradient#download" class="rounded-full border border-neutral-300 dark:border-neutral-700 font-bold px-6 py-3 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4">Download PNG</button>
  </div>
  <label for="gradient-css" class="sr-only">Gradient CSS</label>
  <textarea id="gradient-css" readonly rows="4" data-gradient-target="css" class="bg-white dark:bg-neutral-800 w-full rounded-xl border border-neutral-300 dark:border-neutral-700 p-4 font-mono text-sm focus-visible:outline-2 focus-visible:outline-offset-4"></textarea>
  <p role="status" aria-live="polite" aria-atomic="true" data-gradient-target="status" class="text-sm mt-3"></p>

  <template data-gradient-target="template">
    <fieldset class="min-w-0 rounded-xl border border-neutral-200 dark:border-neutral-700 p-4">
      <legend class="px-1 text-sm font-bold"></legend>
      <div class="flex items-end gap-3">
        <div class="shrink-0">
          <label data-label="picker" class="sr-only">Color picker</label>
          <input type="color" data-field="picker" class="w-10 h-12 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4">
        </div>
        <div class="flex-1 min-w-0">
          <label data-label="color" class="block text-xs font-bold mb-2">Hex</label>
          <input type="text" data-field="color" spellcheck="false" autocomplete="off" class="bg-white dark:bg-neutral-800 w-full min-w-0 rounded-lg border border-neutral-300 dark:border-neutral-700 px-2 py-3 font-mono text-sm focus-visible:outline-2 focus-visible:outline-offset-4 aria-invalid:border-red-600">
        </div>
        <div class="w-20 shrink-0">
          <label data-label="position" class="block text-xs font-bold mb-2">Position (%)</label>
          <input type="number" min="0" max="100" step="0.01" data-field="position" class="bg-white dark:bg-neutral-800 w-full rounded-lg border border-neutral-300 dark:border-neutral-700 px-2 py-3 text-sm focus-visible:outline-2 focus-visible:outline-offset-4 aria-invalid:border-red-600">
        </div>
      </div>
      <button type="button" data-remove class="text-sm underline underline-offset-4 mt-3 py-2 cursor-pointer disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-4">Remove</button>
    </fieldset>
  </template>
</section>
