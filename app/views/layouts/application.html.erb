<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Palette Wow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Palette Wow">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= javascript_include_tag "theme", "data-turbo-track": "reload" %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <!-- <link rel="icon" href="/icon.svg" type="image/svg+xml"> -->
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  </head>

  <body class="bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 border-none min-h-screen flex flex-col" style="font-family: 'Outfit', sans-serif;">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white dark:focus:bg-neutral-900 focus:p-3 focus:rounded-lg">Skip to content</a>
    <nav class="border-b border-neutral-200 dark:border-neutral-700 relative z-50 bg-white dark:bg-neutral-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-3 min-h-16 py-3">
          <div class="flex items-center gap-4">
            <%= link_to root_path, class: "font-outfit text-2xl font-bold tracking-tight inline-block", aria: { label: "paletteWOW Home" } do %>
              palette<span class="gradient-text font-bold">WOW</span>
            <% end %>
            <button type="button" role="switch" aria-label="Dark mode" aria-checked="false" data-theme-toggle hidden class="p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 dark:hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" /></svg>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 hidden dark:block"><circle cx="12" cy="12" r="4" /><path stroke-linecap="round" d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
            </button>
          </div>
          <div class="ml-auto flex flex-wrap items-center gap-x-6 gap-y-3">
            <details class="relative" data-controller="tools" data-action="keydown->tools#keydown click@window->tools#closeOutside focusout->tools#focusout turbo:before-cache@document->tools#reset">
              <summary class="text-sm font-medium hover:text-neutral-500 dark:hover:text-neutral-400 transition-colors cursor-pointer py-2 rounded focus-visible:outline-2 focus-visible:outline-offset-4">Tools</summary>
              <nav aria-label="Tools" class="absolute right-0 top-full mt-2 w-52 max-h-[70dvh] overflow-y-auto rounded-xl border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 shadow-lg p-2">
                <% tool_navigation_links.each do |label, path| %>
                  <%= link_to label, path, class: "block px-3 py-3 text-sm font-medium rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 focus-visible:outline-2 focus-visible:-outline-offset-2" %>
                <% end %>
              </nav>
            </details>
            <%= link_to "GitHub", "https://github.com/scwlkr/paletteWOW", class: "text-sm font-medium hover:text-neutral-500 dark:hover:text-neutral-400 transition-colors" %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="bg-black dark:bg-white text-white dark:text-neutral-900 px-4 py-3 text-center text-sm font-medium" role="alert">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-red-100 dark:bg-red-950 border-l-4 border-red-500 text-red-700 dark:text-red-300 px-4 py-3 text-center text-sm font-medium" role="alert">
        <%= alert %>
      </div>
    <% end %>

    <main id="main-content" tabindex="-1" class="<%= content_for(:main_class) || 'flex-grow w-full py-8 flex flex-col' %>">
      <%= yield %>
    </main>

    <footer class="mt-auto border-t border-neutral-200 dark:border-neutral-700 py-6">
      <nav aria-label="Footer" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <% tool_navigation_links.each do |label, path| %>
          <%= link_to label, path, class: "py-2 text-sm font-medium hover:text-neutral-500 dark:hover:text-neutral-400 transition-colors rounded focus-visible:outline-2 focus-visible:outline-offset-4" %>
        <% end %>
        <%= link_to "Privacy Policy", privacy_path, class: "py-2 text-sm text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors rounded focus-visible:outline-2 focus-visible:outline-offset-4" %>
      </nav>
    </footer>
  </body>
</html>
