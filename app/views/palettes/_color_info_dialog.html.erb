<dialog data-palette-target="colorInfoDialog" data-action="keydown->palette#trapDialogFocus click->palette#closeColorInfoOnBackdrop" aria-labelledby="color-info-title" class="m-auto w-[calc(100%_-_2rem)] max-w-lg max-h-[90dvh] overflow-y-auto rounded-2xl bg-white dark:bg-neutral-900 text-black dark:text-neutral-100 shadow-2xl p-0 backdrop:bg-black/60 backdrop:backdrop-blur-sm">
  <div class="p-6 sm:p-8">
    <div class="flex items-center justify-between gap-4 mb-6">
      <div class="flex items-center gap-3">
        <div data-palette-target="colorInfoPreview" class="w-10 h-10 rounded-full border border-neutral-200 dark:border-neutral-700" aria-hidden="true"></div>
        <h2 id="color-info-title" class="text-2xl font-black tracking-tight">Color info</h2>
      </div>
      <form method="dialog">
        <button aria-label="Close color info" autofocus class="p-2 text-neutral-400 hover:text-black dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded-full focus-visible:ring-2 focus-visible:ring-black dark:focus-visible:ring-white focus:outline-none">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5" aria-hidden="true"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </form>
    </div>
    <dl class="divide-y divide-neutral-200 dark:divide-neutral-700">
      <% %w[HEX RGB HSL HSB CMYK LAB Name].each do |format| %>
        <div class="flex items-center gap-3 py-3">
          <dt class="w-12 shrink-0 text-xs font-bold uppercase text-neutral-500 dark:text-neutral-400"><%= format %></dt>
          <dd data-palette-target="colorInfoValue" data-format="<%= format %>" class="flex-1 min-w-0 break-words font-mono text-sm select-text"></dd>
          <button type="button" aria-label="Copy <%= format %>" data-action="click->palette#copyColorInfo" class="shrink-0 rounded-full border border-neutral-200 dark:border-neutral-700 px-3 py-2 text-xs font-bold hover:bg-neutral-100 dark:hover:bg-neutral-800 focus-visible:ring-2 focus-visible:ring-black dark:focus-visible:ring-white focus:outline-none">Copy</button>
        </div>
      <% end %>
    </dl>
    <p data-palette-target="colorInfoStatus" role="status" class="mt-3 min-h-5 text-sm text-neutral-600 dark:text-neutral-300"></p>
  </div>
</dialog>
